[Unit]
Description=Update the pool league fixture feed
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm \
    --name getpoolcal \
    -v getpoolcal-work:/work \
    -v /etc/getpoolcal/deploy_key:/run/secrets/deploy_key:ro \
    getpoolcal:latest
